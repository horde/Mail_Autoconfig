{
    "name": "horde/mail_autoconfig",
    "description": "Mail server autoconfiguration library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-03-15",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/http": "^3 || dev-FRAMEWORK_6_0",
        "horde/imap_client": "^3 || dev-FRAMEWORK_6_0",
        "horde/mail": "^3 || dev-FRAMEWORK_6_0",
        "horde/smtp": "^2 || dev-FRAMEWORK_6_0",
        "mikepultz/netdns2": "^2.0",
        "ext-SimpleXML": "*"
    },
    "require-dev": {},
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_Mail_Autoconfig": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Mail\\Autoconfig\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
    }
}